{
  "name": "martini-mt-lounge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit.test.js",
    "test:rules": "node --test --test-concurrency=1 tests/rules.test.js",
    "test:e2e": "playwright test",
    "dev:emulators": "vite --host 0.0.0.0 --mode emulator"
  },
  "dependencies": {
    "firebase": "13.2.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
