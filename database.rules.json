{
  "rules": {
    ".read": false,
    ".write": false,
    "mtChatV1": {
      "sessions": {
        "$session": {
          ".read": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.child('meta/ownerUid').val() === auth.uid && $session.matches(/^[A-Za-z0-9_-]{20}$/)",
          ".validate": "newData.hasChildren(['meta', 'stage'])",
          "meta": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['ownerUid', 'title', 'createdAt'])",
            "ownerUid": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (newData.val() === data.val() || newData.val() === now)"
            },
            "$other": {
              ".validate": false
            }
          },
          "stage": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['step', 'updatedAt'])",
            "step": {
              ".validate": "newData.val() === 'setup' || newData.val() === 'join' || newData.val() === 'chat' || newData.val() === 'closed'"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          },
          "participants": {
            ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
            "$participant": {
              ".read": "auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val() === $participant",
              ".validate": "$participant.matches(/^[ABCD][1-6]$/) && newData.hasChildren(['name', 'team', 'teamName'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
              },
              "team": {
                ".validate": "newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C' || newData.val() === 'D'"
              },
              "teamName": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "nameIndex": {
            ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
            "$nameKey": {
              ".read": "auth != null && (root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'join' || root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'chat')",
              ".validate": "$nameKey.length <= 192 && $nameKey.matches(/^[a-f0-9]+$/)",
              "$participant": {
                ".validate": "$participant.matches(/^[ABCD][1-6]$/) && newData.hasChildren(['name', 'teamName'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
                },
                "teamName": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "bindings": {
            "$participant": {
              ".read": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid || (auth != null && data.child('uid').val() === auth.uid)",
              ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid || (auth != null && (root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'join' || root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'chat') && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && !root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists())",
              ".validate": "newData.hasChildren(['uid','claimedAt']) && root.child('mtChatV1/sessions').child($session).child('participants').child($participant).exists() && newData.parent().parent().child('devices').child(newData.child('uid').val()).child('participantId').val() === $participant",
              "uid": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
              },
              "claimedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "devices": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid || (auth != null && auth.uid === $uid && (root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'join' || root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'chat') && !data.exists() && newData.exists())",
              ".validate": "newData.hasChildren(['participantId']) && newData.parent().parent().child('bindings').child(newData.child('participantId').val()).child('uid').val() === $uid",
              "participantId": {
                ".validate": "newData.isString() && newData.val().matches(/^[ABCD][1-6]$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "presence": {
            "$uid": {
              ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid && !newData.exists()",
              "$connection": {
                ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && newData.child('participantId').val() === root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()))",
                ".validate": "newData.hasChildren(['participantId','connectedAt']) && $connection.matches(/^[A-Za-z0-9_-]{20}$/)",
                "participantId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2"
                },
                "connectedAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "instructions": {
            "$participant": {
              ".read": "auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val() === $participant",
              ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid",
              ".validate": "newData.hasChildren(['id','title','body','createdAt'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
              },
              "title": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "responses": {
            "$participant": {
              ".read": "auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val() === $participant",
              ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val() === $participant && newData.exists() && newData.child('instructionId').val() === root.child('mtChatV1/sessions').child($session).child('instructions').child($participant).child('id').val()",
              ".validate": "newData.hasChildren(['instructionId','acknowledgedAt'])",
              "instructionId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
              },
              "acknowledgedAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "sendState": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && newData.exists() && (!data.exists() || data.child('lastSentAt').val() <= now - 1000)",
              ".validate": "newData.hasChildren(['lastSentAt','lastMessageId'])",
              "lastSentAt": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "lastMessageId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "messages": {
            "$channel": {
              ".read": "(auth != null && root.child('mtChatV1/sessions').child($session).child('meta/ownerUid').val() === auth.uid || (auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && ($channel === 'all' || root.child('mtChatV1/sessions').child($session).child('participants').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('team').val() === $channel))) && query.orderByChild === 'sentAt' && query.limitToLast != null && query.limitToLast <= 100",
              ".indexOn": [
                "sentAt"
              ],
              "$messageId": {
                ".write": "auth != null && root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).exists() && root.child('mtChatV1/sessions').child($session).child('bindings').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('uid').val() === auth.uid && root.child('mtChatV1/sessions').child($session).child('stage/step').val() === 'chat' && !data.exists() && newData.exists() && ($channel === 'all' || root.child('mtChatV1/sessions').child($session).child('participants').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('team').val() === $channel)",
                ".validate": "newData.hasChildren(['uid','participantId','name','team','teamName','text','sentAt']) && newData.child('uid').val() === auth.uid && newData.child('participantId').val() === root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val() && newData.child('name').val() === root.child('mtChatV1/sessions').child($session).child('participants').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('name').val() && newData.child('team').val() === root.child('mtChatV1/sessions').child($session).child('participants').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('team').val() && newData.child('teamName').val() === root.child('mtChatV1/sessions').child($session).child('participants').child(root.child('mtChatV1/sessions').child($session).child('devices').child(auth.uid).child('participantId').val()).child('teamName').val() && (!root.child('mtChatV1/sessions').child($session).child('sendState').child(auth.uid).exists() || root.child('mtChatV1/sessions').child($session).child('sendState').child(auth.uid).child('lastSentAt').val() <= now - 1000) && newData.parent().parent().parent().child('sendState').child(auth.uid).child('lastSentAt').val() === now && newData.parent().parent().parent().child('sendState').child(auth.uid).child('lastMessageId').val() === $messageId",
                "uid": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                },
                "participantId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2"
                },
                "name": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
                },
                "team": {
                  ".validate": "newData.val() === 'A' || newData.val() === 'B' || newData.val() === 'C' || newData.val() === 'D'"
                },
                "teamName": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
                },
                "text": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000 && !newData.val().matches(/^[ ]*$/)"
                },
                "sentAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
